        {
          "type": "Condition",
          "props": {
            "variable": "score",
            "op": ">=",
            "value": 10,
            "actions": [
              {
                "type": "LoadScene",
                "scene": "assets/scenes/win.kiln.json"
              }
            ]
          }
        },
        {
          "type": "Condition",
          "props": {
            "variable": "time",
            "op": "<=",
            "value": 0,
            "actions": [
              {
                "type": "LoadScene",
                "scene": "assets/scenes/lose.kiln.json"
              }
            ]
          }
        }
      ],
      "children": []
    }
