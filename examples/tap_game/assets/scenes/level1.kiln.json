      ],
      "size": [
        380.0,
        50.0
      ],
      "angle": 0.0,
      "behaviors": [
        {
          "type": "Text",
          "props": {
            "text": "Score: {score}/10   Time: {time}",
            "fontSize": 24,
            "color": "#FFFFFF"
          }
        }
      ],
      "children": []
    },
    {
