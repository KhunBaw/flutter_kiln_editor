      ],
      "size": [
        340.0,
        20.0
      ],
      "angle": 0.0,
      "behaviors": [
        {
          "type": "Spawner",
          "props": {
            "prefab": "Balloon",
            "interval": 0.8,
            "max": 0
          }
        }
      ],
      "children": []
    },
    {
      "id": "rules",
      "name": "rules",
      "position": [
        0.0,
        0.0
      ],
      "size": [
        1.0,
        1.0
      ],
      "angle": 0.0,
      "behaviors": [
        {
